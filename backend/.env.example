APP_NAME=WhatsApp Expense Tracker
ENVIRONMENT=development
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Use Jev for intent classification.
INTENT_CLASSIFIER=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=4
JEV_MIN_CONFIDENCE=0.6
JEV_FALLBACK_TO_GROQ=true

# Optional local field extraction: use merged requirements.txt with Python 3.12.
# Select gliner2 after downloading the model; groq is the default.
EXTRACTION_PROVIDER=groq
GLINER2_MODEL_ID=fastino/gliner2-base-v1
GLINER2_REVISION=f9634218e53580c56edf0de97ca1a7d3f1c2354e
GLINER2_LOCAL_FILES_ONLY=false
GLINER2_ENTITY_THRESHOLD=0.4
GLINER2_CLASSIFICATION_THRESHOLD=0.5
GLINER2_NUM_THREADS=4
GLINER2_FALLBACK_TO_GROQ=false
DATABASE_URL=your_supabase_database_url

# Each dashboard user proves ownership by messaging a login code to the bot.
DASHBOARD_AUTH_MODE=whatsapp
DASHBOARD_SESSION_HOURS=24
DASHBOARD_LOGIN_MINUTES=5
# Set to the public dashboard origin on deployment, e.g. https://ledger.example.com.
DASHBOARD_PUBLIC_URL=
# Secure cookies are automatic when ENVIRONMENT=production.
# DASHBOARD_COOKIE_SECURE=true
# Deprecated shared-token access is only available with DASHBOARD_AUTH_MODE=legacy
# in development. Production never accepts it.
# DASHBOARD_API_TOKEN=
# DASHBOARD_USER_ID=

# Twilio signature validation and scheduled outbound messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://your-domain.example/webhook/whatsapp

# Optional receipt image extraction
GROQ_VISION_MODEL=
